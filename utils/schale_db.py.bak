# Boss name → armor type weakness mapping
_RAID_WEAKNESS: Dict[str, str] = {
    "Binah": "HeavyArmor",
    "Kaiten": "LightArmor",
    "Hieronymus": "LightArmor",
    "Hod": "HeavyArmor",
    "HOD": "HeavyArmor",
    "Chesed": "HeavyArmor",
    "Shirokuro": "ElasticArmor",
    "ShiroKuro": "ElasticArmor",
    "Gregorius": "Unarmed",
    "Perorozilla": "ElasticArmor",
    "Goz": "Unarmed",
    "EN-0": "LightArmor",
    "Kurokage": "HeavyArmor",
}

async def get_raid_teams(boss_name: str, region: str = DEFAULT_REGION, limit: int = 10) -> Dict[str, Any]:
    """
    Suggest students for a raid boss based on armor weakness.
    Returns dict with 'boss', 'weakness', 'recommended' list.
    """
    await _load_data(region)
    reg_key = "en" if region.lower() == "global" else "jp"
    data = _REGION_CACHE.get(reg_key, [])

    # Find weakness via mapping or fuzzy match key
    weakness = None
    for key, armor in _RAID_WEAKNESS.items():
        if boss_name.lower() in key.lower() or key.lower() in boss_name.lower():
            weakness = armor
            break

    if not weakness:
        return {"boss": boss_name, "weakness": "Unknown", "recommended": []}

    candidates = [s for s in data if (s.get("BulletType") or "") != "None" and s.get("AttackPower100", 0) > 0]
    
    # Score: effective = bullet hits weakness + high ATK
    bullet_effective = {
        "LightArmor": ["Explosion", "Mystic"],
        "HeavyArmor": ["Pierce"],
        "Unarmed": ["Mystic", "Sonic"],
        "ElasticArmor": ["Explosion", "Sonic"],
    }
    good_bullets = bullet_effective.get(weakness, [])

    scored = []
    for s in candidates:
        bullet = s.get("BulletType", "")
        atk = s.get("AttackPower100", 0)
        bonus = 1.5 if bullet in good_bullets else 1.0
        scored.append({"student": s, "score": atk * bonus})

    scored.sort(key=lambda x: x["score"], reverse=True)
    recommended = [
        {
            "name": x["student"].get("Name"),
            "role": x["student"].get("TacticRole"),
            "bullet": x["student"].get("BulletType"),
            "atk": x["student"].get("AttackPower100"),
        }
        for x in scored[:limit]
    ]

    return {"boss": boss_name, "weakness": weakness, "recommended": recommended}

async def get_student_gear(name: str, region: str = DEFAULT_REGION) -> Optional[Dict]:
    """Get unique gear info for a specific student"""
    student = await get_student_info(name, region)
    if not student:
        return None
    gear = student.get("Gear")
    if not gear:
        return {"name": name, "gear": None, "note": "No unique gear"}
    return {
        "name": student.get("Name"),
        "gear_name": gear.get("Name"),
        "tier": gear.get("Tier"),
        "stats": gear.get("StatType", []),
        "stat_values": gear.get("StatValue", []),
        "desc": clean_tags(gear.get("Desc", "")),
    }

async def format_student_comparison(name1: str, name2: str, region: str = DEFAULT_REGION) -> str:
    """Compare two students side by side into a formatted string for Gemini context"""
    s1 = await get_student_info(name1, region)
    s2 = await get_student_info(name2, region)
    if not s1 and not s2:
        return "Both students not found."
    if not s1:
        return f"{name1} not found."
    if not s2:
        return f"{name2} not found."

    def row(label, k):
        return f"{label:<18} {str(s1.get(k, 'N/A')):<20} {str(s2.get(k, 'N/A'))}"

    lines = [
        f"{'':18} {s1.get('Name', ''):<20} {s2.get('Name', '')}",
        "-" * 58,
        row("Stars", "StarGrade"),
        row("School", "School"),
        row("Role", "TacticRole"),
        row("Squad", "SquadType"),
        row("Bullet", "BulletType"),
        row("Armor", "ArmorType"),
        row("Position", "Position"),
        row("ATK (max)", "AttackPower100"),
        row("HP (max)", "MaxHP100"),
        row("DEF (max)", "DefensePower100"),
        row("HEAL (max)", "HealPower100"),
        row("Crit Rate", "CriticalPoint"),
        row("Evasion", "DodgePoint"),
        row("Range", "Range"),
        row("Urban", "StreetBattleAdaptation"),
        row("Outdoor", "OutdoorBattleAdaptation"),
        row("Indoor", "IndoorBattleAdaptation"),
    ]
    return "\n".join(lines)

async def get_students_summary(region: str = DEFAULT_REGION, limit: int = 0) -> str:
    """
    Return a compact roster dump: Name | Role | School | BulletType
    Useful for giving Gemini a full picture of available students.
    limit=0 means all students.
    """
    await _load_data(region)
    reg_key = "en" if region.lower() == "global" else "jp"
    data = _REGION_CACHE.get(reg_key, [])
    if not data:
        return "No student data available."

    pool = data if not limit else data[:limit]
    lines = [f"{'Name':<22} {'Role':<16} {'School':<14} {'Bullet'}"]
    lines.append("-" * 62)
    for s in pool:
        name = (s.get("Name") or "")[:21]
        role = (s.get("TacticRole") or "")[:15]
        school = (s.get("School") or "")[:13]
        bullet = s.get("BulletType") or ""
        lines.append(f"{name:<22} {role:<16} {school:<14} {bullet}")
    lines.append(f"\nTotal: {len(pool)} students")
    return "\n".join(lines)

# ──────────────────────────────────────────────────────────────────────────────
# Birthday helpers
# ──────────────────────────────────────────────────────────────────────────────

_MONTH_NAMES = {
    "january": 1, "february": 2, "march": 3, "april": 4,
    "may": 5, "june": 6, "july": 7, "august": 8,
    "september": 9, "october": 10, "november": 11, "december": 12,
    "jan": 1, "feb": 2, "mar": 3, "apr": 4,
    "jun": 6, "jul": 7, "aug": 8,
    "sep": 9, "oct": 10, "nov": 11, "dec": 12,
}

def _parse_birthday(birthday_str: str) -> Optional[tuple]:
    """
    Parse birthday string → (month: int, day: int).
    Handles: "March 28", "28 March", "3/28", "03-28", "28.3", "3月28日"
    Returns None if unparseable.
    """
    if not birthday_str:
        return None
    s = birthday_str.strip()

    # Strip ordinal suffixes: "31st" → "31", "25th" → "25", "2nd" → "2"
    s = re.sub(r'(\d+)(st|nd|rd|th)\b', r'\1', s)

    # "Month DD" or "DD Month"
    parts = re.split(r"[\s/\-\.]", s)
    if len(parts) == 2:
        a, b = parts
        a_key = a.lower().rstrip(".")
        b_key = b.lower().rstrip(".")
        if a_key in _MONTH_NAMES:
            try:
                return (_MONTH_NAMES[a_key], int(b))
            except ValueError:
                pass
        if b_key in _MONTH_NAMES:
            try:
                return (_MONTH_NAMES[b_key], int(a))
            except ValueError:
                pass
        # "MM/DD" numeric
        try:
            m, d = int(a), int(b)
            if 1 <= m <= 12 and 1 <= d <= 31:
                return (m, d)
        except ValueError:
            pass

    # Japanese: "3月28日"
    jp = re.match(r"(\d{1,2})月(\d{1,2})日", s)
    if jp:
        return (int(jp.group(1)), int(jp.group(2)))

    # stdlib strptime fallback
    for fmt in ("%B %d", "%b %d", "%d %B", "%d %b", "%m/%d", "%m-%d"):
        try:
            dt = datetime.strptime(s, fmt)
            return (dt.month, dt.day)
        except ValueError:
            continue

    return None


_BIRTHDAY_CACHE: tuple[tuple[int, int], list] | None = None  # ((month, day), students)

async def get_today_birthdays(region: str = DEFAULT_REGION) -> list:
    """Return all students whose birthday matches today's UTC date. Cached per day."""
    global _BIRTHDAY_CACHE
    today = datetime.now(timezone.utc)
    today_key = (today.month, today.day)
    if _BIRTHDAY_CACHE is not None and _BIRTHDAY_CACHE[0] == today_key:
        return _BIRTHDAY_CACHE[1]
    await _load_data(region)
    reg_key = "en" if region.lower() == "global" else "jp"
    data = _REGION_CACHE.get(reg_key, [])
    result = [s for s in data if _parse_birthday(s.get("Birthday", "")) == today_key]
    _BIRTHDAY_CACHE = (today_key, result)
    return result


async def get_birthdays_on_date(
    month: int, day: int, region: str = DEFAULT_REGION
) -> List[Dict]:
    """Return all students born on the given (month, day)."""
    await _load_data(region)
    reg_key = "en" if region.lower() == "global" else "jp"
    data = _REGION_CACHE.get(reg_key, [])
    return [
        s for s in data
        if _parse_birthday(s.get("Birthday", "")) == (month, day)
    ]


async def find_student_birthday(
    name: str, region: str = DEFAULT_REGION
) -> Optional[Dict]:
    """
    Look up a student's birthday by name (fuzzy-matched).
    Returns {"name", "birthday", "school"} or None if not found.
    """
    student = await get_student_info(name, region)
    if not student:
        return None
    return {
        "name": student.get("Name"),
        "birthday": student.get("Birthday", "Unknown"),
        "school": student.get("School"),
    }


def build_birthday_prompt_block(today_students: List[Dict]) -> str:
    """
    Returns a one-line prompt injection string for today's birthdays.
    Returns "" if nobody has a birthday today (zero token cost).

    Example: "[Today's Blue Archive Birthdays (UTC): Shiroko, Hoshino]"
    """
    if not today_students:
        return ""
    names = [s.get("Name", "Unknown") for s in today_students]
    return f"[Today's Blue Archive Student Birthdays (UTC): {', '.join(names)}]"


