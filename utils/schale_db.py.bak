async def format_raid_info(raids: Dict[str, Any]) -> str:
    """
    Format raid information into readable text for Gemini.
    
    Args:
        raids: Raid data from get_raids()
    
    Returns:
        Formatted string with raid information
    """
    if not raids:
        return "No raid information available."
    
    lines = ["=== Blue Archive Raids ===\n"]
    
    # Current raids
    current = raids.get("current", [])
    if current:
        lines.append("CURRENT RAIDS:")
        for raid in current:
            end_time = raid.get("endAt", "Unknown")
            if isinstance(end_time, (int, float)):
                end_time = format_timestamp(int(end_time))
            lines.append(f"{raid.get('bossName', 'Unknown')} (Season {raid.get('seasonId', '?')})")
            lines.append(f"  Ends: {end_time}")
        lines.append("")
    
    # Upcoming raids
    upcoming = raids.get("upcoming", [])
    if upcoming:
        lines.append("UPCOMING RAIDS:")
        for raid in upcoming[:3]:  # Show next 3
            start_time = raid.get("startAt", "Unknown")
            if isinstance(start_time, (int, float)):
                start_time = format_timestamp(int(start_time))
            lines.append(f"{raid.get('bossName', 'Unknown')} (Season {raid.get('seasonId', '?')})")
            lines.append(f"  Starts: {start_time}")
        lines.append("")
    
    return "\n".join(lines)

async def format_event_info(events: Dict[str, Any]) -> str:
    """
    Format event information into readable text for Gemini.
    
    Args:
        events: Event data from get_events()
    
    Returns:
        Formatted string with event information
    """
    if not events:
        return "No event information available."
    
    lines = ["=== Blue Archive Events ===\n"]
    
    # Current events
    current = events.get("current", [])
    if current:
        lines.append("CURRENT EVENTS:")
        for event in current:
            end_time = event.get("endAt", "Unknown")
            if isinstance(end_time, (int, float)):
                end_time = format_timestamp(int(end_time))
            lines.append(f"{event.get('name', 'Unknown')} ({event.get('type', 'Event')})")
            lines.append(f"  Ends: {end_time}")
        lines.append("")
    
    # Upcoming events
    upcoming = events.get("upcoming", [])
    if upcoming:
        lines.append("UPCOMING EVENTS:")
        for event in upcoming[:3]:  # Show next 3
            start_time = event.get("startAt", "Unknown")
            if isinstance(start_time, (int, float)):
                start_time = format_timestamp(int(start_time))
            lines.append(f"{event.get('name', 'Unknown')} ({event.get('type', 'Event')})")
            lines.append(f"  Starts: {start_time}")
        lines.append("")
    
    return "\n".join(lines)


