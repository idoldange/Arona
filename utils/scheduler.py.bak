import sqlite3
import asyncio
import time
import os
from datetime import datetime, timezone, timedelta
from contextlib import contextmanager
from console.console import log  
from config import MAX_SCHEULED_TASK_RETRIES  

# --- Database Setup ---
DB_DIR = "./database"
DB_PATH = os.path.join(DB_DIR, "schedule.db")

if not os.path.exists(DB_DIR):
    os.makedirs(DB_DIR)


@contextmanager
def get_db():
    """Context manager for safe DB connections — tự động đóng và rollback nếu lỗi."""
    conn = sqlite3.connect(DB_PATH)
    try:
        yield conn
        conn.commit()
    except Exception as e:
        conn.rollback()
        raise e
    finally:
        conn.close()


def init_db():
    """
    Initializes the SQLite database.
    Tạo bảng nếu chưa có, rồi migrate thêm các cột loop nếu thiếu (backward-compatible).
    """
    try:
        with get_db() as conn:
            c = conn.cursor()

            # Bảng chính
            c.execute('''CREATE TABLE IF NOT EXISTS schedules
                         (id          INTEGER PRIMARY KEY AUTOINCREMENT,
                          type        TEXT,
                          content     TEXT,
                          trigger_time REAL,
                          channel_id  INTEGER,
                          message_id  INTEGER,
                          user_id     INTEGER,
                          created_at  TEXT,
                          loop_type   TEXT,
                          loop_every  REAL,
                          loop_at_time TEXT,
                          loop_at_day  INTEGER)''')

            # Migration: thêm cột loop cho DB cũ (SQLite không hỗ trợ IF NOT EXISTS cho cột)
            existing_cols = {row[1] for row in c.execute("PRAGMA table_info(schedules)")}
            migration_cols = {
                "loop_type":    "TEXT",
                "loop_every":   "REAL",
                "loop_at_time": "TEXT",
                "loop_at_day":  "INTEGER",
                "retry_count":  "INTEGER DEFAULT 0",
            }
            for col, col_type in migration_cols.items():
                if col not in existing_cols:
                    c.execute(f"ALTER TABLE schedules ADD COLUMN {col} {col_type}")
                    log(f"Migrated DB: added column '{col}'.", "DEBUG")

        log("Schedule database initialized with Loop support.", "DEBUG")
    except Exception as e:
        log(f"Database initialization failed: {e}", "ERROR")


# ─────────────────────────────────────────────
# Loop Helper
# ─────────────────────────────────────────────

def _parse_hhmm(value: str) -> tuple[int, int]:
    """
    Parse loop_at_time into (hour, minute).
    Accepts "HH:MM", "HH:MM UTC", "HH:MM+07:00", etc.
    Always extracts only the first two numeric tokens separated by ':'.
    """
    import re
    m = re.match(r"(\d{1,2}):(\d{2})", value.strip())
    if not m:
        raise ValueError(f"Cannot parse loop_at_time: {value!r}. Expected HH:MM format.")
    return int(m.group(1)), int(m.group(2))


def _calc_next_trigger(loop_type: str, loop_every, loop_at_time: str, loop_at_day) -> float:
    """
    Tính timestamp lần trigger tiếp theo dựa vào kiểu lặp.

    loop_type values:
      "interval" — lặp sau mỗi loop_every giây kể từ NOW
      "daily"    — lặp mỗi ngày lúc loop_at_time (HH:MM UTC)
      "weekly"   — lặp mỗi tuần vào loop_at_day (0=Mon…6=Sun) lúc loop_at_time UTC
      "monthly"  — lặp mỗi tháng vào ngày loop_at_day (1–31) lúc loop_at_time UTC
    """
    now = datetime.now(timezone.utc)

    if loop_type == "interval":
        return time.time() + float(loop_every)

    if loop_type == "daily":
        h, m = _parse_hhmm(loop_at_time)
        candidate = now.replace(hour=h, minute=m, second=0, microsecond=0)
        if candidate <= now:
            candidate += timedelta(days=1)
        return candidate.timestamp()

    if loop_type == "weekly":
        h, m = _parse_hhmm(loop_at_time)
        target_dow = int(loop_at_day)          # 0 = Monday … 6 = Sunday
        days_ahead = target_dow - now.weekday()
        if days_ahead < 0:
            days_ahead += 7
        candidate = (now + timedelta(days=days_ahead)).replace(
            hour=h, minute=m, second=0, microsecond=0
        )
        if candidate <= now:                   # same weekday but time passed
            candidate += timedelta(weeks=1)
        return candidate.timestamp()

    if loop_type == "monthly":
        h, m = _parse_hhmm(loop_at_time)
        dom = int(loop_at_day)                 # 1–31
        try:
            candidate = now.replace(day=dom, hour=h, minute=m, second=0, microsecond=0)
        except ValueError:
            # ngày không tồn tại trong tháng hiện tại → nhảy tháng sau
            candidate = None

        if candidate is None or candidate <= now:
            # tiến sang tháng kế
            if now.month == 12:
                next_month_dt = now.replace(year=now.year + 1, month=1)
            else:
                next_month_dt = now.replace(month=now.month + 1)
            try:
                candidate = next_month_dt.replace(day=dom, hour=h, minute=m, second=0, microsecond=0)
            except ValueError:
                # tháng kế cũng không có ngày đó (vd: 31/2) → cuối tháng
                import calendar
                last_day = calendar.monthrange(next_month_dt.year, next_month_dt.month)[1]
                candidate = next_month_dt.replace(day=last_day, hour=h, minute=m, second=0, microsecond=0)
        return candidate.timestamp()

    raise ValueError(f"Unknown loop_type: {loop_type}")


def _loop_desc(loop_type, loop_every, loop_at_time, loop_at_day) -> str:
    """Trả về chuỗi mô tả lịch lặp dễ đọc."""
    DOW = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
    if loop_type == "interval":
        return f"every {loop_every}s"
    if loop_type == "daily":
        return f"daily at {loop_at_time} UTC"
    if loop_type == "weekly":
        day_name = DOW[int(loop_at_day)] if 0 <= int(loop_at_day) <= 6 else f"day{loop_at_day}"
        return f"weekly on {day_name} at {loop_at_time} UTC"
    if loop_type == "monthly":
        return f"monthly on day {loop_at_day} at {loop_at_time} UTC"
    return "unknown loop"


def _split_message(text: str, max_length: int = 2000) -> list[str]:
    """Split text into Discord-safe chunks."""
    parts = []
    while len(text) > max_length:
        idx = text.rfind('\n', 0, max_length)
        if idx == -1:
            idx = text.rfind(' ', 0, max_length)
        if idx == -1:
            idx = max_length
        parts.append(text[:idx].strip())
        text = text[idx:].strip()
    if text:
        parts.append(text)
    return parts


# Background Heartbeat
async def scheduler_heartbeat(client, ask_gemini_func, extract_func, send_func=None, mood_func=None):
    """
    The main background loop.
    Checks the database every 10 seconds for due tasks.
    One-shot tasks → DELETE after execute.
    Loop tasks     → UPDATE trigger_time to next occurrence after execute.

    send_func : optional async callable(channel, text) — defaults to channel.send with split
    mood_func : optional callable(text) -> text — strips <mood> tags and applies mood delta
    """
    init_db()
    log("Arona's Scheduler Heartbeat is pulsing...", "INFO")

    async def _send(channel, text: str):
        """Send text to channel, splitting if needed, applying mood_func if provided."""
        if mood_func:
            text = mood_func(text)
        if send_func:
            await send_func(channel, text)
        else:
            for chunk in (_split_message(text) if len(text) > 2000 else [text]):
                await channel.send(chunk)

    while True:
        try:
            now_ts = time.time()

            with get_db() as conn:
                c = conn.cursor()

                c.execute(
                    """SELECT id, type, content, trigger_time, channel_id, message_id, user_id,
                              loop_type, loop_every, loop_at_time, loop_at_day, retry_count
                       FROM schedules WHERE trigger_time <= ?""",
                    (now_ts,)
                )
                tasks = c.fetchall()
                
                for task in tasks:
                    (task_id, t_type, content, t_time,
                     channel_id, message_id, user_id,
                     loop_type, loop_every, loop_at_time, loop_at_day, retry_count) = task

                    # Check if task has exceeded max retries
                    if retry_count > MAX_SCHEULED_TASK_RETRIES:
                        log(f"Task {task_id} has exceeded max retries ({retry_count}). Deleting to prevent infinite failures.", "ERROR")
                        c.execute("DELETE FROM schedules WHERE id = ?", (task_id,))
                        continue

                    channel = client.get_channel(channel_id)
                    if not channel:
                        # Increment retry count for this task
                        c.execute(
                            "UPDATE schedules SET retry_count = retry_count + 1 WHERE id = ?",
                            (task_id,)
                        )
                        log(f"Channel {channel_id} not found. Task {task_id} retry #{retry_count + 1}.", "WARN")
                        continue

                    try:
                        log(f"Executing {t_type} (ID: {task_id}, loop={loop_type})", "INFO")

                        # ── Execute ──────────────────────────────────────
                        if t_type == "message":
                            await _send(channel, content)

                        elif t_type == "task":
                            target_message = None
                            try:
                                target_message = await channel.fetch_message(message_id)
                            except Exception as fetch_err:
                                log(f"Could not fetch message {message_id}: {fetch_err}. Using partial.", "WARN")
                                target_message = channel.get_partial_message(message_id)
                                if not hasattr(target_message, "author") or target_message.author is None:
                                    target_message.author = client.user

                            text = (
                                "Context: You are executing a scheduled task. "
                                "This is your notes when you schedule this task: " + content
                            )
                            response = await ask_gemini_func(
                                text=text, sys_prompt=True, message=target_message,
                                enable_functions=True, timeout=60000
                            )
                            final_text = extract_func(response)

                            if final_text:
                                await _send(channel, final_text)
                            else:
                                log(f"Task {task_id} returned empty response.", "WARN")

                        # ── Task executed successfully → reset retry count ──
                        c.execute("UPDATE schedules SET retry_count = 0 WHERE id = ?", (task_id,))

                        # ── Post-execute: loop vs one-shot ───────────────
                        if loop_type:
                            next_ts = _calc_next_trigger(loop_type, loop_every, loop_at_time, loop_at_day)
                            next_str = datetime.fromtimestamp(next_ts, tz=timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
                            c.execute(
                                "UPDATE schedules SET trigger_time = ? WHERE id = ?",
                                (next_ts, task_id)
                            )
                            log(f"Loop task {task_id} rescheduled → next: {next_str}", "INFO")
                        else:
                            c.execute("DELETE FROM schedules WHERE id = ?", (task_id,))
                            log(f"Task {task_id} completed and removed.", "INFO")

                    except Exception as task_err:
                        log(f"Failed to execute task {task_id}: {task_err}", "ERROR")

        except Exception as e:
            log(f"Error in Scheduler Heartbeat: {e}", "ERROR")

        await asyncio.sleep(10)


# ─────────────────────────────────────────────
# One-shot Public Tools  (không đổi so với bản gốc)
# ─────────────────────────────────────────────

async def schedule_message(channel, content, send_time, timetype="absolute", message=None):
    """Tool: Schedules a plain one-shot message."""
    try:
        st = float(send_time)
        now_ts = time.time()
        trigger = (now_ts + st) if timetype == "relative" else st

        user_id = message.author.id if message else None
        created_at = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")

        with get_db() as conn:
            c = conn.cursor()
            c.execute(
                """INSERT INTO schedules
                   (type, content, trigger_time, channel_id, message_id, user_id, created_at)
                   VALUES (?, ?, ?, ?, ?, ?, ?)""",
                ("message", content, trigger, channel.id, None, user_id, created_at),
            )

        trigger_dt = datetime.fromtimestamp(trigger, tz=timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
        log(f"Message scheduled by {user_id} for {trigger_dt}", "INFO")
        return f"Message successfully scheduled: '{content}' ({timetype}) — will send at {trigger_dt}."

    except Exception as e:
        log(f"Error in schedule_message: {e}", "ERROR")
        return f"Error: {str(e)}"


async def schedule_task(prompt, trigger_time, message, timetype="absolute"):
    """Tool: Schedules a one-shot Gemini-based task."""
    try:
        tt = float(trigger_time)
        now_ts = time.time()
        trigger = (now_ts + tt) if timetype == "relative" else tt

        created_at_str = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
        trigger_str = datetime.fromtimestamp(trigger, tz=timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")

        with get_db() as conn:
            c = conn.cursor()
            c.execute(
                """INSERT INTO schedules
                   (type, content, trigger_time, channel_id, message_id, user_id, created_at)
                   VALUES (?, ?, ?, ?, ?, ?, ?)""",
                ("task", prompt, trigger, message.channel.id, message.id, message.author.id, created_at_str),
            )

        log(f"Task scheduled by {message.author.id} (Created: {created_at_str})", "INFO")
        return (
            f"Task logged in Shittim Chest!\n"
            f"- Prompt: {prompt}\n"
            f"- Created at: {created_at_str}\n"
            f"- Scheduled for: {trigger_str} ({timetype})"
        )

    except Exception as e:
        log(f"Error in schedule_task: {e}", "ERROR")
        return f"Error: {str(e)}"


# ─────────────────────────────────────────────
# Loop Schedule Tool
# ─────────────────────────────────────────────

async def schedule_loop(
    action: str,
    loop_type: str,
    message,
    # --- action-specific params ---
    content: str = "",           # nội dung message hoặc prompt cho task
    # --- loop params ---
    loop_every: float = None,    # giây, chỉ dùng khi loop_type="interval"
    loop_at_time: str = None,    # "HH:MM" UTC, dùng cho daily/weekly/monthly
    loop_at_day: int = None,     # 0-6 (weekly) hoặc 1-31 (monthly)
    # --- first trigger ---
    first_trigger_time: float = None,   # Unix timestamp tuyệt đối cho lần chạy đầu
    first_trigger_delay: float = None,  # giây tính từ bây giờ cho lần chạy đầu
):
    """
    Tool: Schedules a RECURRING task.

    Parameters
    ----------
    action : "message" | "task"
        Loại hành động lặp lại.

    loop_type : "interval" | "daily" | "weekly" | "monthly"
        - "interval"  → lặp mỗi `loop_every` giây
        - "daily"     → lặp mỗi ngày lúc `loop_at_time` (HH:MM UTC)
        - "weekly"    → lặp mỗi tuần, vào `loop_at_day` (0=Mon…6=Sun)
                        lúc `loop_at_time` UTC
        - "monthly"   → lặp mỗi tháng, vào ngày `loop_at_day` (1–31)
                        lúc `loop_at_time` UTC

    content : str
        Nội dung tin nhắn (action="message") hoặc prompt (action="task").

    loop_every : float
        Bắt buộc khi loop_type="interval". Đơn vị: giây.

    loop_at_time : str  (HH:MM)
        Bắt buộc khi loop_type in {"daily","weekly","monthly"}.

    loop_at_day : int
        Bắt buộc khi loop_type in {"weekly","monthly"}.
        weekly: 0=Mon, 1=Tue, …, 6=Sun
        monthly: 1–31

    first_trigger_time : float (Unix timestamp, tuyệt đối)
        Thời điểm chạy lần đầu. Nếu không truyền, tính tự động từ loop params.

    first_trigger_delay : float (giây)
        Thay thế cho first_trigger_time nếu muốn delay đơn giản (tính từ now).
    """
    try:
        # ── Validate action ──
        if action not in ("message", "task"):
            return f"Error: action must be 'message' or 'task', got '{action}'."

        # ── Validate loop_type ──
        valid_loop_types = ("interval", "daily", "weekly", "monthly")
        if loop_type not in valid_loop_types:
            return f"Error: loop_type must be one of {valid_loop_types}, got '{loop_type}'."

        # ── Validate loop params ──
        if loop_type == "interval":
            if loop_every is None:
                return "Error: loop_every (seconds) is required for loop_type='interval'."
            loop_every = float(loop_every)
        else:
            if loop_at_time is None:
                return f"Error: loop_at_time (HH:MM UTC) is required for loop_type='{loop_type}'."
            # Normalize: strip any suffix like " UTC", timezone offsets, etc.
            import re as _re
            _m = _re.match(r"(\d{1,2}:\d{2})", loop_at_time.strip())
            if not _m:
                return f"Error: loop_at_time must be HH:MM format, got '{loop_at_time}'."
            loop_at_time = _m.group(1)
            if loop_type in ("weekly", "monthly") and loop_at_day is None:
                return f"Error: loop_at_day is required for loop_type='{loop_type}'."

        # ── Tính first trigger ──
        if first_trigger_delay is not None:
            first_ts = time.time() + float(first_trigger_delay)
        elif first_trigger_time is not None:
            first_ts = float(first_trigger_time)
        else:
            # Mặc định: tính từ loop params (lần tiếp theo theo lịch)
            first_ts = _calc_next_trigger(loop_type, loop_every, loop_at_time, loop_at_day)

        created_at = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
        first_ts_str = datetime.fromtimestamp(first_ts, tz=timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")

        t_type = action   # "message" hoặc "task"
        channel_id = message.channel.id
        msg_id     = message.id if action == "task" else None
        user_id    = message.author.id

        with get_db() as conn:
            c = conn.cursor()
            c.execute(
                """INSERT INTO schedules
                   (type, content, trigger_time, channel_id, message_id, user_id, created_at,
                    loop_type, loop_every, loop_at_time, loop_at_day)
                   VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
                (t_type, content, first_ts, channel_id, msg_id, user_id, created_at,
                 loop_type, loop_every, loop_at_time, loop_at_day),
            )

        desc = _loop_desc(loop_type, loop_every, loop_at_time, loop_at_day)
        log(f"Loop {t_type} scheduled by {user_id} [{desc}] first={first_ts_str}", "INFO")
        return (
            f"Loop task registered!\n"
            f"- Action  : {action}\n"
            f"- Content : {content[:60]}{'...' if len(content) > 60 else ''}\n"
            f"- Schedule: {desc}\n"
            f"- First run: {first_ts_str}"
        )

    except Exception as e:
        log(f"Error in schedule_loop: {e}", "ERROR")
        return f"Error: {str(e)}"


# ─────────────────────────────────────────────
# List / Delete / Clear  (hỗ trợ cả one-shot lẫn loop)
# ─────────────────────────────────────────────

async def list_user_tasks(message):
    """Tool: Returns a list of ALL pending tasks (one-shot + loop) for the calling user."""
    try:
        with get_db() as conn:
            c = conn.cursor()
            c.execute(
                """SELECT id, type, content, trigger_time, created_at,
                          loop_type, loop_every, loop_at_time, loop_at_day
                   FROM schedules WHERE user_id = ?
                   ORDER BY trigger_time""",
                (message.author.id,),
            )
            tasks = c.fetchall()

        if not tasks:
            return "Sensei's Shittim Chest schedule is currently empty."

        res = "**sensei's Pending Tasks:**\n"
        for t in tasks:
            t_id, t_type, content, t_time, c_at, l_type, l_every, l_at_time, l_at_day = t
            t_dt    = datetime.fromtimestamp(t_time, tz=timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
            preview = content[:50] + "..." if len(content) > 50 else content
            loop_info = f" | {_loop_desc(l_type, l_every, l_at_time, l_at_day)}" if l_type else ""
            res += (
                f"ID: {t_id} | Type: {t_type}{loop_info} | "
                f"Next: {t_dt} | Created: {c_at} | Context: {preview}\n"
            )
        return res

    except Exception as e:
        log(f"Error in list_user_tasks: {e}", "ERROR")
        return f"Error: {str(e)}"


async def delete_user_task(task_id, message):
    """Tool: Deletes a task (one-shot OR loop) if it belongs to the calling user."""
    try:
        with get_db() as conn:
            c = conn.cursor()
            c.execute(
                "SELECT id FROM schedules WHERE id = ? AND user_id = ?",
                (task_id, message.author.id),
            )
            if not c.fetchone():
                return f"Task ID {task_id} not found or doesn't belong to you, Sensei."
            c.execute("DELETE FROM schedules WHERE id = ?", (task_id,))

        log(f"Task {task_id} deleted by {message.author.id}", "INFO")
        return f"Successfully removed Task ID {task_id}."

    except Exception as e:
        log(f"Error in delete_user_task: {e}", "ERROR")
        return f"Error: {str(e)}"


async def clear_user_tasks(message):
    """Tool: Deletes ALL pending tasks (one-shot + loop) belonging to the calling user."""
    try:
        with get_db() as conn:
            c = conn.cursor()
            c.execute("SELECT COUNT(*) FROM schedules WHERE user_id = ?", (message.author.id,))
            count = c.fetchone()[0]

            if count == 0:
                return "This Sensei don't have any pending tasks to clear!"

            c.execute("DELETE FROM schedules WHERE user_id = ?", (message.author.id,))

        log(f"All {count} tasks cleared for user {message.author.id}", "INFO")
        return f"Successfully cleared all {count} pending tasks from your schedule, Sensei! ✨"

    except Exception as e:
        log(f"Error in clear_user_tasks: {e}", "ERROR")
        return f"Error: {str(e)}"


# ─────────────────────────────────────────────
# Get / Edit
# ─────────────────────────────────────────────

async def get_task(task_ids: list[int], message):
    """Tool: Returns full content of one or more tasks belonging to the calling user.

    Parameters
    ----------
    task_ids : list[int]
        One or more task IDs to retrieve (get IDs from list_user_tasks).
    """
    try:
        with get_db() as conn:
            c = conn.cursor()
            placeholders = ",".join("?" * len(task_ids))
            c.execute(
                f"""SELECT id, type, content, trigger_time, created_at,
                           loop_type, loop_every, loop_at_time, loop_at_day
                    FROM schedules
                    WHERE id IN ({placeholders}) AND user_id = ?
                    ORDER BY trigger_time""",
                (*task_ids, message.author.id),
            )
            tasks = c.fetchall()

        if not tasks:
            return f"No tasks found for ID(s) {task_ids} belonging to you, Sensei."

        found_ids = {t[0] for t in tasks}
        missing = [i for i in task_ids if i not in found_ids]

        lines = []
        for t in tasks:
            t_id, t_type, content, t_time, c_at, l_type, l_every, l_at_time, l_at_day = t
            t_dt = datetime.fromtimestamp(t_time, tz=timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
            loop_info = f"\n  Loop     : {_loop_desc(l_type, l_every, l_at_time, l_at_day)}" if l_type else ""
            lines.append(
                f"── Task ID {t_id} ──\n"
                f"  Type     : {t_type}\n"
                f"  Created  : {c_at}\n"
                f"  Next Run : {t_dt}"
                f"{loop_info}\n"
                f"  Content  :\n{content}"
            )

        result = "\n\n".join(lines)
        if missing:
            result += f"\n\n⚠️ Not found (or not yours): {missing}"
        return result

    except Exception as e:
        log(f"Error in get_task: {e}", "ERROR")
        return f"Error: {str(e)}"


_EDITABLE_FIELDS = {
    "type":         ("TEXT",    lambda v: v if v in ("message", "task") else (_ for _ in ()).throw(ValueError(f"type must be 'message' or 'task', got '{v}'"))),
    "content":      ("TEXT",    str),
    "trigger_time": ("REAL",    float),
    "loop_type":    ("TEXT",    lambda v: v if v in ("interval", "daily", "weekly", "monthly", "") else (_ for _ in ()).throw(ValueError(f"Invalid loop_type '{v}'"))),
    "loop_every":   ("REAL",    float),
    "loop_at_time": ("TEXT",    str),
    "loop_at_day":  ("INTEGER", int),
}

async def edit_task(task_id: int, field: str, value: str, message):
    """Tool: Edit a single field of an existing task owned by the calling user.

    Parameters
    ----------
    task_id : int
        ID of the task to edit (get from list_user_tasks).
    field : str
        Field to update. One of: type, content, trigger_time, loop_type,
        loop_every, loop_at_time, loop_at_day.
    value : str
        New value (always passed as string; converted to correct type internally).
        Pass empty string to clear optional loop fields.
    """
    if field not in _EDITABLE_FIELDS:
        return f"Error: '{field}' is not editable. Choose from: {', '.join(_EDITABLE_FIELDS)}."

    try:
        _, converter = _EDITABLE_FIELDS[field]
        # Allow clearing nullable fields with empty string
        if value == "" and field in ("loop_type", "loop_at_time"):
            converted = None
        elif value == "" and field in ("loop_every", "loop_at_day"):
            converted = None
        else:
            converted = converter(value)
    except (ValueError, StopIteration) as e:
        return f"Error: invalid value for '{field}': {e}"

    try:
        with get_db() as conn:
            c = conn.cursor()
            c.execute(
                "SELECT id FROM schedules WHERE id = ? AND user_id = ?",
                (task_id, message.author.id),
            )
            if not c.fetchone():
                return f"Task ID {task_id} not found or doesn't belong to you, Sensei."

            c.execute(
                f"UPDATE schedules SET {field} = ? WHERE id = ?",
                (converted, task_id),
            )

        log(f"Task {task_id} field '{field}' updated by {message.author.id} → {converted!r}", "INFO")
        return f"Task ID {task_id}: `{field}` updated to `{converted}`."

    except Exception as e:
        log(f"Error in edit_task: {e}", "ERROR")
        return f"Error: {str(e)}"


# ─────────────────────────────────────────────
# Misc
# ─────────────────────────────────────────────

async def wait_for_time(wait_time):
    """Simple wait tool."""
    log(f"Waiting for {wait_time} seconds.", "DEBUG")
    await asyncio.sleep(float(wait_time))
    return f"Wait completed for {wait_time} seconds."