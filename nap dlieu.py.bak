import chromadb
from sentence_transformers import SentenceTransformer
import uuid
from datetime import datetime

class AronaUnifiedArchive:
    def __init__(self):
        # Kết nối tới database vật lý
        self.client = chromadb.PersistentClient(path="./database/vector_db")
        self.collection = self.client.get_or_create_collection("arona_memories")
        
        # ÉP CHẠY TRÊN CPU - Tận dụng 64GB RAM của Danteh-sama
        print("--- [System] Loading BGE-M3 model on CPU... ---")
        self.model = SentenceTransformer('BAAI/bge-m3', device='cpu')
        print("--- [System] Unified Memory Core Initialized. ---")

    def add_entry(self, content, category):
        doc_id = str(uuid.uuid4())
        vector = self.model.encode([content])[0].tolist()
        self.collection.add(
            ids=[doc_id],
            embeddings=[vector],
            documents=[content],
            metadatas=[{"school_category": category, "timestamp": str(datetime.now())}]
        )
        print(f"   [Archived][{category}]: {content[:70]}...")

# --- TOÀN BỘ CƠ SỞ DỮ LIỆU ĐÃ PHÂN MỤC ---
UNIFIED_DATA = {
    "hangdongwibu.io": [
        "Hangdongwibu.io is a small social nettwork for Artist and writer.",
        "More info at https://hangdongwibu.io and https://linktr.ee/giaohoiwibu"
    ]
   
}

def start_supreme_ingestion():
    archive = AronaUnifiedArchive()
    print("\n" + "="*60)
    print("BẮT ĐẦU ĐỒNG BỘ HÓA ĐẠI LƯU TRỮ NHẤT QUÁN")
    print("="*60)
    
    for school, chunks in UNIFIED_DATA.items():
        print(f"\n>>> Đang nạp phân viện: {school}")
        for chunk in chunks:
            archive.add_entry(chunk, school)
            
    print("\n" + "="*60)
    print("HOÀN TẤT! Arona đã trở thành Thủ thư tối cao của Danteh-sama.")
    print("="*60)

if __name__ == "__main__":
    start_supreme_ingestion()